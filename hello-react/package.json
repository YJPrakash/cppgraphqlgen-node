{
  "name": "hello-react",
  "version": "0.1.0",
  "private": true,
  "main": "./src/startElectron.js",
  "dependencies": {
    "graphiql": "^3.4.0",
    "graphql": "^16.9.0",
    "graphql-ws": "^5.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "electron": "electron . --no-sandbox",
    "start": "PORT=3001 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently -k -s first \"npm start\" \"wait-on http://localhost:3001/ && electron .\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-is-dev": "^2.0.0",
    "eslint-config-react-app": "^7.0.1"
  }
}
